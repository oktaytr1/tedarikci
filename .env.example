# =============================================================================
# Ortam değişkenleri. Bu dosya şablondur; gerçek değerler .env dosyasına (git'e girmez)
# ya da barındırma panelinin "Environment Variables" bölümüne yazılır.
# Ayrıntı ve üretim adımları: README.md → "Yayına alma".
# =============================================================================

# --- Üretimde ZORUNLU ---------------------------------------------------------

# PostgreSQL 16 bağlantısı. Üretimde ayrı kullanıcı + güçlü parola; uzak sunucudaysa TLS:
#   postgresql://KULLANICI:PAROLA@SUNUCU:5432/VERITABANI?schema=public&sslmode=require
# Parolada özel karakter varsa URL-kodlanmalı (ör. node -e 'console.log(encodeURIComponent("p@r0la"))').
# Yerel geliştirme: docker compose up -d db
DATABASE_URL="postgresql://tp:tp_yerel_parola@localhost:5432/tedarikci?schema=public"

# Auth.js oturum (JWT) imzalama anahtarı. Her ortamda AYRI ve rastgele; sızarsa değiştirilir
# (değişince tüm oturumlar düşer). Üretmek için:  openssl rand -base64 32
AUTH_SECRET=""

# Uygulamanın dış adresi (https, sonda / yok). Auth.js yönlendirmeleri ve çerez alanı buna göre.
AUTH_URL="http://localhost:3000"

# Ters vekil (Coolify/Traefik, Nginx) arkasında Auth.js'in Host başlığına güvenmesi için.
# Kendi sunucuda "true"; Vercel'de gerekmez.
AUTH_TRUST_HOST="true"

# --- Üretimde İSTEĞE BAĞLI ----------------------------------------------------

# Migration'lar için doğrudan bağlantı (uygulama bir bağlantı havuzu arkasındaysa).
# Boşsa migration'lar DATABASE_URL ile çalışır.
DIRECT_DATABASE_URL=""

# Tedarikçi ekranında "ürün düzeltmesi için" gösterilen platform iletişim bilgisi.
# Telefon boşsa ekranda telefon satırı hiç görünmez.
PLATFORM_ILETISIM_EPOSTA=""
PLATFORM_ILETISIM_TELEFON=""

# --- YALNIZ GELİŞTİRME (üretime KONMAZ) -----------------------------------------

# Otomatik testler (npm test). Adı _test ile bitmeli; testler tabloları TRUNCATE eder.
TEST_DATABASE_URL="postgresql://tp:tp_yerel_parola@localhost:5432/tedarikci_test?schema=public"

# npm run db:ornek'in açtığı geliştirme hesaplarının parolası (yoksa betik üretip buraya yazar).
# ORNEK_ADMIN_PAROLA=""
