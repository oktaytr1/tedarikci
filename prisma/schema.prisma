// Sadeleştirilmiş B2B Katalog — yalnızca Urun tablosu.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Urun {
  id           Int      @id @default(autoincrement())
  kod          String   @unique
  ad           String
  aciklama     String?
  kategori     String?
  fotograf_url String?
  birim        String   @default("adet")
  koli_adedi   Int?
  min_siparis  Decimal? @db.Decimal(18, 3)
  liste_fiyat  Decimal  @db.Decimal(18, 2)
  kdv_orani    Decimal  @db.Decimal(5, 2)  @default(20.00)
  aktif        Boolean  @default(true)
  olusturma    DateTime @default(now()) @db.Timestamptz(3)
  guncelleme   DateTime @updatedAt @db.Timestamptz(3)

  @@index([kategori])
  @@index([aktif])
  @@map("urun")
}
